{
  "name": "IPvFooKan",
  "manifest_version": 3,
  "version": "0.1",
  "description": "Realtime server IP (IPv4/IPv6, HTTP/3, TLS), BGP AS-Path traceroute, Link & Asset Grabber, and In-Page META SEO Diagnostics.",
  "homepage_url": "https://github.com/mm1rza/ipvfoo",
  "icons": {
    "16": "icon16.png",
    "128": "icon128.png"
  },
  "background": {
    "scripts": ["iputil.js", "common.js", "background.js"]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "ipvfookan@mm1rza.github",
      "strict_min_version": "115.0"
    },
    "gecko_android": {
      "strict_min_version": "120.0"
    }
  },
  "page_action": {
    "default_icon": {
      "16": "icon16_transparent.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "browser_style": false
  },
  "permissions": [
    "contextMenus",
    "storage",
    "webNavigation",
    "webRequest"
  ],
  "host_permissions": [
    "<all_urls>"
  ]
}
