{
  "name": "IPvFooKan",
  "manifest_version": 3,
  "version": "0.1",
  "default_locale": "en",
  "description": "Realtime server IP (IPv4/IPv6, HTTP/3, TLS), BGP AS-Path traceroute, Link & Asset Grabber, and In-Page META SEO Diagnostics.",
  "homepage_url": "https://github.com/mm1rza/ipvfoo",
  "icons": {
    "16": "icons/icon16.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16_transparent.png"
    }
  },
  "options_ui": {
    "page": "options.html"
  },
  "permissions": [
    "alarms",
    "contextMenus",
    "storage",
    "webNavigation",
    "webRequest",
    "offscreen"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "scripts/defines.js",
        "scripts/service.js",
        "scripts/url2service.js",
        "scripts/extractors.js",
        "scripts/extractors3.js",
        "scripts/seo-extractor.js",
        "id_asn_default.js",
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://bgp.he.net/*"],
      "js": ["bgp_he.js"],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "seo.html",
        "scripts/seo.js",
        "icons/icon128.png"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
